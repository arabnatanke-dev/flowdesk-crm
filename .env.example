# PostgreSQL or Neon connection string used by the server and Drizzle migrations.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# At least 32 random characters used to protect low-entropy identifiers in audit/rate-limit hashes.
SECURITY_PEPPER=replace-with-at-least-32-random-characters

# Initial owner account created by `npm run db:seed`.
SEED_ORG_SLUG=horizon
SEED_ORG_NAME=Horizon Home Services
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=replace-with-a-long-random-password
SEED_ADMIN_NAME=FlowDesk Owner
